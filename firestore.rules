rules_version = '2';

// CATATAN PENTING:
// Aplikasi ini memakai sistem login kustom (bukan Firebase Authentication),
// sehingga Firestore Security Rules TIDAK BISA memverifikasi "siapa yang sedang login"
// (tidak ada request.auth). Rules di bawah ini hanya membatasi BENTUK data yang boleh
// ditulis, bukan SIAPA yang menulis — siapa pun yang tahu URL aplikasi tetap bisa
// membaca/menulis Firestore secara langsung lewat API jika mereka mau.
//
// Ini cukup untuk pemakaian internal skala kecil/menengah dengan pengguna yang saling
// percaya (kantor/instansi). Untuk keamanan tingkat produksi yang lebih ketat, migrasikan
// login ke Firebase Authentication (custom token / email-password) lalu perbarui rules ini
// agar memakai request.auth.uid.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['nip', 'nama', 'bagian', 'jabatan', 'passwordHash', 'role'])
                    && request.resource.data.role in ['admin', 'pegawai'];
      allow update, delete: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /absensi/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['uid', 'tanggal', 'jam', 'status']);
      // Diizinkan agar admin bisa mengoreksi (ubah/hapus) data absen yang sudah tersimpan
      // lewat menu Koreksi Absensi. Karena tidak ada Firebase Authentication di aplikasi ini,
      // rules ini tidak bisa membatasi hanya ke admin — lihat catatan keamanan di bagian atas file.
      allow update, delete: if true;
    }

    // Dipakai oleh halaman Basedata (menu SIPP) untuk menyimpan rekap presensi bulanan
    // yang diunggah dari file Excel. Halaman ini terpisah dari aplikasi e-Apel utama.
    match /sipp/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Dipakai oleh halaman Basedata (menu Penilaian ASN → Data Pegawai) untuk menyimpan
    // data induk kepegawaian (NIP, Nama, Jabatan, Unit Kerja, Atasan).
    match /dataPegawai/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Dipakai oleh halaman Basedata (menu Penilaian Individu → Kelola Atasan Penilai)
    // untuk menyimpan penetapan atasan penilai & pegawai binaannya per periode (bulan-tahun).
    match /atasanPenilai/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Dipakai oleh halaman Basedata (menu Penilaian Individu → Nilai Pegawai) untuk
    // menyimpan hasil penilaian individu ASN per periode (bulan-tahun) per pegawai.
    match /penilaianIndividu/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Dipakai oleh halaman Basedata (menu Penilaian Individu → Daftar Pimpinan) untuk
    // menyimpan akun Pimpinan (NIP, Nama, Jabatan, passwordHash) yang nanti dipakai untuk login.
    match /pimpinan/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Dipakai oleh halaman Basedata (menu e-Kinerja) untuk menyimpan data e-Kinerja
    // yang diunggah dari file Excel per periode (bulan-tahun).
    match /eKinerja/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Data e-Kinerja khusus untuk perhitungan TPP (menu Nilai ASN), terpisah dari
    // koleksi eKinerja di atas yang dipakai untuk Reward & Punishment.
    match /eKinerjaTpp/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
